    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
