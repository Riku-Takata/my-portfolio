---
import type { z } from 'astro/zod';
import type { projectSchema } from '../../lib/schemas';
import { formatPeriod } from '../../lib/format';
import Badge from './Badge.astro';
import LinkButton from './LinkButton.astro';
import ExternalLink from '../icons/ExternalLink.astro';

interface Props {
  project: { id: string; data: z.output<typeof projectSchema> };
}

const { project } = Astro.props;
const { title, period, summary, tech, outcomes, links } = project.data;
const periodText = formatPeriod(period);
const detailHref = `/projects/${project.id}/`;
---

<article class="rounded-lg border border-zinc-200 p-5 dark:border-zinc-800">
  <h3 class="text-base font-semibold">{title}</h3>
  <p class="text-sm text-zinc-500 dark:text-zinc-400">{periodText}</p>
  <p class="mt-3 text-sm text-zinc-700 dark:text-zinc-300">{summary}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {tech.map((t) => (
      <Badge>{t}</Badge>
    ))}
  </div>
  <ul class="mt-3 list-disc pl-5 text-sm">
    {outcomes.map((o) => (
      <li>{o}</li>
    ))}
  </ul>
  <div class="mt-4 flex flex-wrap gap-2">
    {links?.demo && (
      <LinkButton href={links.demo}>
        {'Live Demo'}
        <ExternalLink />
      </LinkButton>
    )}
    {links?.github && (
      <LinkButton href={links.github}>
        {'GitHub Code'}
        <ExternalLink />
      </LinkButton>
    )}
    <LinkButton href={detailHref}>技術解説を読む →</LinkButton>
  </div>
</article>
