---
import type { ProjectEntry } from '../../lib/schemas';
import { formatExperiencePeriod } from '../../lib/format';
import { sortLinks, linkLabel } from '../../lib/links';
import Badge from './Badge.astro';
import LinkButton from './LinkButton.astro';
import Github from '../icons/Github.astro';
import ExternalLink from '../icons/ExternalLink.astro';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const periodText = formatExperiencePeriod(project.context.period);
const sortedLinks = sortLinks(project.links);
---

<article class="rounded-lg border border-zinc-200 p-5 dark:border-zinc-800">
  <div class="flex flex-wrap items-center gap-2">
    <Badge>{project.context.label}</Badge>
    <span class="text-sm text-zinc-500 dark:text-zinc-400">{periodText}</span>
  </div>
  <h3 class="mt-3 text-base font-semibold">{project.title}</h3>
  <p class="mt-2 text-sm text-zinc-700 dark:text-zinc-300">{project.summary}</p>
  <p class="mt-3 border-l-2 border-zinc-300 pl-3 text-sm font-medium dark:border-zinc-700">
    {project.highlight}
  </p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {project.techStack.map((t) => (
      <Badge>{t}</Badge>
    ))}
  </div>
  {sortedLinks.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {sortedLinks.map((link) => (
        <LinkButton href={link.url}>
          {link.media === 'github' ? <Github /> : <ExternalLink />}
          <span>{link.label ?? linkLabel(link.media)}</span>
        </LinkButton>
      ))}
    </div>
  )}
</article>
