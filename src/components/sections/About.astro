---
import Section from '../common/Section.astro';
import Badge from '../ui/Badge.astro';
import LinkButton from '../ui/LinkButton.astro';
import Github from '../icons/Github.astro';
import Zenn from '../icons/Zenn.astro';
import Note from '../icons/Note.astro';
import SpeakerDeck from '../icons/SpeakerDeck.astro';
import ExternalLink from '../icons/ExternalLink.astro';
import type { Domain, MediaPolicyItem, Profile } from '../../lib/schemas';

interface Props {
  domains: readonly Domain[];
  mediaPolicy: readonly MediaPolicyItem[];
  links: Profile['links'];
}

const { domains, mediaPolicy, links } = Astro.props;
const MEDIA = {
  github: { name: 'GitHub', Icon: Github, href: links.github },
  zenn: { name: 'Zenn', Icon: Zenn, href: links.zenn },
  note: { name: 'note', Icon: Note, href: links.note },
  slide: { name: 'Speaker Deck', Icon: SpeakerDeck, href: links.speakerDeck },
} as const;
const items = mediaPolicy.map((m) => ({ ...m, ...MEDIA[m.media] }));
---

<Section id="about" label="About">
  <ul class="grid gap-3 sm:grid-cols-2">
    {domains.map((d) => (
      <li class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
        <p class="text-sm font-semibold">{d.title}</p>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
          {d.description}
        </p>
        {d.keywords.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {d.keywords.map((k) => (
              <Badge>{k}</Badge>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>
  <h3 class="mt-8 mb-3 text-sm font-semibold">Media Policy</h3>
  <ul class="space-y-3">
    {items.map(({ Icon, name, href, role, description }) => (
      <li class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
        <div class="flex flex-wrap items-center gap-2">
          <Icon />
          <span class="text-sm font-semibold">{name}</span>
          <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
            {role}
          </span>
        </div>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
          {description}
        </p>
        <div class="mt-3">
          <LinkButton href={href}>
            プロフィールを見る
            <ExternalLink />
          </LinkButton>
        </div>
      </li>
    ))}
  </ul>
</Section>
