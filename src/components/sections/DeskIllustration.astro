---
interface Props {
  class?: string;
}

const { class: className = 'w-40' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  aria-hidden="true"
  class={className}
  fill="none"
>
  <g>
    <path
      class="desk-steam desk-steam-1 stroke-zinc-400 dark:stroke-zinc-500"
      d="M9 21L9.55279 19.8944C9.83431 19.3314 9.83431 18.6686 9.55279 18.1056L9 17L8.44721 15.8944C8.16569 15.3314 8.16569 14.6686 8.44721 14.1056L9 13"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <path
      class="desk-steam desk-steam-2 stroke-zinc-400 dark:stroke-zinc-500"
      d="M6.5 22L7.05279 20.8944C7.33431 20.3314 7.33431 19.6686 7.05279 19.1056L6.5 18L5.94721 16.8944C5.66569 16.3314 5.66569 15.6686 5.94721 15.1056L6.5 14"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
  </g>

  <g>
    <rect
      x="17"
      y="28"
      width="20"
      height="3"
      class="fill-zinc-200 stroke-zinc-700 dark:fill-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="18"
      y="17"
      width="18"
      height="11"
      class="fill-zinc-900 stroke-zinc-700 dark:fill-zinc-950 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <defs>
      <clipPath id="desk-screen-clip">
        <rect x="19" y="18" width="16" height="9"></rect>
      </clipPath>
    </defs>
    <g clip-path="url(#desk-screen-clip)">
      <text
        class="desk-code desk-code-1 fill-indigo-400 dark:fill-indigo-300 font-mono"
        x="19.5"
        y="20.5"
        font-size="1.2"
      >
        {'const greet = () => {'}
      </text>
      <text
        class="desk-code desk-code-2 fill-indigo-400 dark:fill-indigo-300 font-mono"
        x="20.5"
        y="22.5"
        font-size="1.2"
      >
        {"console.log('hi');"}
      </text>
      <text
        class="desk-code desk-code-3 fill-indigo-400 dark:fill-indigo-300 font-mono"
        x="19.5"
        y="24.5"
        font-size="1.2"
      >
        {'};'}
      </text>
    </g>
  </g>

  <g>
    <rect
      x="5"
      y="24"
      width="5"
      height="7"
      class="fill-zinc-200 stroke-zinc-700 dark:fill-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <path
      d="M10 28C11.1046 28 12 27.1046 12 26C12 24.8954 11.1046 24 10 24"
      class="stroke-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
      fill="none"
    ></path>
    <rect
      x="6"
      y="25"
      width="3"
      height="1"
      class="fill-zinc-300 dark:fill-zinc-600"
    ></rect>
  </g>

  <g>
    <rect
      x="44"
      y="27"
      width="14"
      height="4"
      class="fill-indigo-100 stroke-zinc-700 dark:fill-indigo-950 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="42"
      y="23"
      width="14"
      height="4"
      class="fill-zinc-200 stroke-zinc-700 dark:fill-zinc-800 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="46"
      y="19"
      width="14"
      height="4"
      class="fill-indigo-200 stroke-zinc-700 dark:fill-indigo-900 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="47"
      y="20"
      width="12"
      height="1"
      class="fill-indigo-400 dark:fill-indigo-700"
    ></rect>
    <rect
      x="43"
      y="24"
      width="12"
      height="1"
      class="fill-zinc-400 dark:fill-zinc-600"
    ></rect>
    <rect
      x="45"
      y="28"
      width="12"
      height="1"
      class="fill-indigo-300 dark:fill-indigo-800"
    ></rect>
  </g>

  <g>
    <rect
      x="4"
      y="31"
      width="56"
      height="5"
      class="fill-zinc-300 stroke-zinc-700 dark:fill-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="10"
      y="36"
      width="30"
      height="6"
      class="fill-zinc-200 stroke-zinc-700 dark:fill-zinc-800 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="6"
      y="36"
      width="4"
      height="24"
      class="fill-zinc-300 stroke-zinc-700 dark:fill-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <rect
      x="40"
      y="36"
      width="18"
      height="24"
      class="fill-zinc-200 stroke-zinc-700 dark:fill-zinc-800 dark:stroke-zinc-400"
      stroke-width="2"
    ></rect>
    <line
      x1="40"
      y1="48"
      x2="58"
      y2="48"
      class="stroke-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></line>
    <line
      x1="22"
      y1="39"
      x2="28"
      y2="39"
      class="stroke-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></line>
    <line
      x1="46"
      y1="42"
      x2="52"
      y2="42"
      class="stroke-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></line>
    <line
      x1="46"
      y1="54"
      x2="52"
      y2="54"
      class="stroke-zinc-700 dark:stroke-zinc-400"
      stroke-width="2"
    ></line>
    <line
      x1="0"
      y1="60"
      x2="64"
      y2="60"
      class="stroke-zinc-400 dark:stroke-zinc-600"
      stroke-width="2"
    ></line>
  </g>
</svg>

<style>
  .desk-steam {
    stroke-dasharray: 6 10;
    animation: desk-steam 2.4s linear infinite;
  }
  .desk-steam-2 {
    animation-delay: 0.4s;
  }
  @keyframes desk-steam {
    0% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -32;
    }
  }
  .desk-code-1 {
    animation: desk-type-1 8s steps(21, end) infinite;
  }
  @keyframes desk-type-1 {
    0%,
    25% {
      clip-path: inset(0 100% 0 0);
    }
    30%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  .desk-code-2 {
    animation: desk-type-2 8s steps(18, end) infinite;
  }
  @keyframes desk-type-2 {
    0%,
    30% {
      clip-path: inset(0 100% 0 0);
    }
    60%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  .desk-code-3 {
    animation: desk-type-3 8s steps(2, end) infinite;
  }
  @keyframes desk-type-3 {
    0%,
    60% {
      clip-path: inset(0 100% 0 0);
    }
    75%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .desk-steam,
    .desk-code {
      animation: none;
    }
  }
</style>
