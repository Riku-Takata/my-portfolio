---
import type { ExperienceKind } from '../../lib/format';
import { experienceKindLabel } from '../../lib/format';
import { formatExperiencePeriod, sortExperience } from '../../lib/format';
import Section from '../common/Section.astro';

interface Props {
  experience: readonly {
    kind: ExperienceKind;
    title: string;
    org: string;
    start: string;
    end?: string;
    note?: string;
  }[];
}

const { experience } = Astro.props;
const items = sortExperience(experience);
---

<Section id="experience" label="Experience & Education">
  <ol class="mt-6 space-y-6 border-l border-zinc-200 pl-6 dark:border-zinc-800">
    {items.map((item) => (
      <li>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          <time datetime={item.start}>{formatExperiencePeriod(item)}</time>
          {' · '}
          {experienceKindLabel(item.kind)}
        </p>
        <h3 class="text-base font-semibold">{item.title}</h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">{item.org}</p>
        {item.note && (
          <p class="text-sm text-zinc-500 dark:text-zinc-400">{item.note}</p>
        )}
      </li>
    ))}
  </ol>
</Section>
