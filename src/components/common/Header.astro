---
import Container from './Container.astro';
import { SITE_NAME } from '../../lib/site';

const items = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#articles', label: 'Articles' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-10 border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950"
>
  <Container>
    <div class="flex h-14 items-center justify-between gap-6">
      <a
        href="/"
        class="shrink-0 text-sm font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
      >
        {SITE_NAME}
      </a>
      <nav
        aria-label="セクション"
        class="flex min-w-0 gap-4 overflow-x-auto whitespace-nowrap text-sm"
      >
        {items.map((item) => (
          <a
            href={item.href}
            class="text-zinc-600 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-zinc-400 dark:hover:text-zinc-100"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </Container>
</header>
